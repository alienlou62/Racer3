<?xml version="1.0" encoding="utf-8"?>
<!--
  Racer3 laser-style RTTaskManager probe settings.

  This file is intentionally separate from racer3-settings.xml. It preserves the
  same network, axis, and MultiAxis configuration, then adds an RTTaskManagers
  block modeled after the working laser demo. Use this only when validating the
  RTTask manager/feedback path. The normal stable UI path can keep using
  racer3-settings.xml.
-->
<XMLSettings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExpectedNodeCount>6</ExpectedNodeCount>
  <ExpectedNodeTypes>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
    <RSINodeType>RSINodeTypeKOLLMORGEN_AKD</RSINodeType>
  </ExpectedNodeTypes>
  <NetworkStartTimeoutMilliseconds xsi:nil="true" />
  <SampleRate>1000</SampleRate>
  <AxisCount>6</AxisCount>
  <MotionCount>7</MotionCount>
  <UserLimitCount>0</UserLimitCount>
  <RecorderCount>0</RecorderCount>
  <RecorderBufferSize />
  <CompensatorCount>0</CompensatorCount>
  <CompensatorPointCount />
  <AxisFrameBufferSize>
    <int>1024</int>
    <int>1024</int>
    <int>1024</int>
    <int>1024</int>
    <int>1024</int>
    <int>1024</int>
  </AxisFrameBufferSize>
  <MathBlockCount>0</MathBlockCount>
  <XMLFiles>
    <AxisXML>
      <AxisNumber>0</AxisNumber>
      <XMLFile>Axis 0.xml</XMLFile>
    </AxisXML>
    <AxisXML>
      <AxisNumber>1</AxisNumber>
      <XMLFile>Axis 1.xml</XMLFile>
    </AxisXML>
    <AxisXML>
      <AxisNumber>2</AxisNumber>
      <XMLFile>Axis 2.xml</XMLFile>
    </AxisXML>
    <AxisXML>
      <AxisNumber>3</AxisNumber>
      <XMLFile>Axis 3.xml</XMLFile>
    </AxisXML>
    <AxisXML>
      <AxisNumber>4</AxisNumber>
      <XMLFile>Axis 4.xml</XMLFile>
    </AxisXML>
    <AxisXML>
      <AxisNumber>5</AxisNumber>
      <XMLFile>Axis 5.xml</XMLFile>
    </AxisXML>
  </XMLFiles>
  <MultiAxisXMLFiles>
  <MultiAxisXML>
    <MotionSupervisorIndex>6</MotionSupervisorIndex>
    <XMLFile>MultiAxis.xml</XMLFile>
  </MultiAxisXML>
  </MultiAxisXMLFiles>
  <RTTaskManagers>
    <RTTaskManager>
      <RTTaskDirectory>C:\RSI\11.0.5</RTTaskDirectory>
      <Platform>INtime</Platform>
      <NodeName>NodeA</NodeName>
      <CpuCore>2</CpuCore>
      <UserLabel>Racer3JogProbe</UserLabel>
      <NoRmp>false</NoRmp>
      <RTTasks>
        <RTTask>
          <FunctionName>Initialize</FunctionName>
          <LibraryName>RTTaskFunctions</LibraryName>
          <LibraryDirectory />
          <UserLabel>Initialize</UserLabel>
          <Priority>Lowest</Priority>
          <Repeats>0</Repeats>
          <Period>1</Period>
          <Phase>0</Phase>
          <EnableTiming>true</EnableTiming>
        </RTTask>
        <RTTask>
          <FunctionName>Increment</FunctionName>
          <LibraryName>RTTaskFunctions</LibraryName>
          <LibraryDirectory />
          <UserLabel>Increment</UserLabel>
